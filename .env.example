# 复制为 .env 后填写（勿提交真实密钥）
# cp .env.example .env

# 唯一对外端口（gateway HTTP）；外层 Nginx 端口转发到此即可
PORT=8080
PUBLIC_HOST=travel.jiangker.cn

# 本机已有 Postgres。容器内不要用 127.0.0.1，用 host.docker.internal
DATABASE_URL=postgres://USER:PASSWORD@host.docker.internal:15432/travel

JWT_SECRET=please-change-to-a-long-random-string
DEV_MODE=0
RUST_LOG=server=info,sqlx=warn,tower_http=info

# 微信小程序（正式环境必填）
WECHAT_APPID=
WECHAT_SECRET=

# 高德 Web 服务（路书导航，可选）
AMAP_KEY=
AMAP_SECRET=

# —— 镜像（可选）——
# BASE_IMAGE=crpi-jya41iij3cykq66t.cn-chengdu.personal.cr.aliyuncs.com/jiangker_love/debian:stable-20240904-slim-shanghai
# APT_MIRROR=http://mirrors.aliyun.com
# 腾讯云可改：APT_MIRROR=http://mirrors.tencentyun.com
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
