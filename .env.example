# 复制为 .env 后填写（勿提交真实密钥）
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=travel
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=travel
POSTGRES_PORT=5432

# 唯一对外端口（gateway）；外层 Nginx 端口转发到此即可
PORT=8080
PUBLIC_HOST=travel.jiangker.cn
JWT_SECRET=please-change-to-a-long-random-string
DEV_MODE=0
RUST_LOG=server=info,sqlx=warn,tower_http=info

# 微信小程序（正式环境必填）
WECHAT_APPID=
WECHAT_SECRET=

# 高德 Web 服务（路书导航，可选）
AMAP_KEY=
AMAP_SECRET=
