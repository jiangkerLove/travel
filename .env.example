# 复制为 .env 后填写（勿提交真实密钥）
# cp .env.example .env

# 数据库（复用已有实例，只填这一项）
# 容器访问宿主机上的库可用 172.17.0.1（Docker 网桥）
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/travel

# 唯一对外端口（gateway）；外层 Nginx 端口转发到此即可
PORT=8080
PUBLIC_HOST=travel.jiangker.cn
JWT_SECRET=please-change-to-a-long-random-string
DEV_MODE=0
RUST_LOG=server=info,sqlx=warn,tower_http=info

# 微信小程序（正式环境必填）
WECHAT_APPID=
WECHAT_SECRET=

# 高德 Web 服务（路书导航，可选）
AMAP_KEY=
AMAP_SECRET=

# 可选：覆盖统一基础镜像（api 构建/运行 + gateway 均基于此）
# BASE_IMAGE=crpi-jya41iij3cykq66t.cn-chengdu.personal.cr.aliyuncs.com/jiangker_love/debian:stable-20240904-slim-shanghai
