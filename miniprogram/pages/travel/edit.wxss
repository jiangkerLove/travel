page {
  background: #f4f9f6;
}

.create-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 80% 50% at 10% -10%, rgba(111, 155, 136, 0.16), transparent 55%),
    radial-gradient(ellipse 70% 40% at 100% 0%, rgba(215, 228, 220, 0.9), transparent 50%),
    #f4f9f6;
}

.intro {
  padding: 20rpx 8rpx 28rpx;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 650;
  color: #2f3b35;
  letter-spacing: 1rpx;
}

.intro-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8fa19a;
  line-height: 1.6;
}

.form-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 28rpx 12rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf5f0;
}

.field.last {
  border-bottom: none;
}

.field-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #edf5f0;
}

.field.half {
  flex: 1;
  padding: 16rpx 0 24rpx;
  border-bottom: none;
}

.date-sep {
  flex-shrink: 0;
  padding-bottom: 30rpx;
  font-size: 22rpx;
  color: #97a8a1;
}

.label {
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.optional {
  margin-left: 8rpx;
  color: #b9ccc3;
  letter-spacing: 0;
}

.input {
  width: 100%;
  font-size: 30rpx;
  color: #2f3b35;
  line-height: 1.4;
  min-height: 44rpx;
}

.picker {
  font-size: 30rpx;
  color: #2f3b35;
  line-height: 1.4;
  min-height: 44rpx;
}

.picker.empty {
  color: #b9ccc3;
}

.area {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #2f3b35;
  line-height: 1.5;
}

.ph {
  color: #b9ccc3;
}

.soft-btn {
  margin-top: 40rpx;
  padding: 28rpx 32rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #4f9f8a;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #d9ece3;
}

.soft-btn.main {
  background: #6cbfa6;
  color: #fff;
  border-color: #6cbfa6;
  box-shadow: 0 12rpx 28rpx rgba(111, 155, 136, 0.28);
}

.soft-btn.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.day-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6cbfa6;
}
