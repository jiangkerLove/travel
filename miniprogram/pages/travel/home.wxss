page {
  height: 100%;
  background: #f3f6f3;
}

.home {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f3f6f3;
  overflow: hidden;
}

.top-fixed {
  flex-shrink: 0;
  padding: 8rpx 24rpx 0;
  background: #f3f6f3;
}

.hero {
  padding: 4rpx 4rpx 10rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  color: #2f3d36;
  line-height: 1.3;
}

.hero-edit {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #6f9b88;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9a90;
  line-height: 1.3;
}

.hero-meta.dest {
  max-height: 40rpx;
  opacity: 1;
  overflow: hidden;
  transition: max-height 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, margin 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

.hero-meta.dest.is-hide {
  max-height: 0;
  opacity: 0;
  margin: 0;
}

.map-wrap {
  position: relative;
  border-radius: 20rpx;
  /* 不要 overflow:hidden 裁切原生 map，否则中间区域会一直闪 */
  background: #e7f1eb;
}

.day-map {
  width: 100%;
  display: block;
  border-radius: 20rpx;
}

.home.is-map-full .top-fixed {
  padding-bottom: 12rpx;
}

.map-fab {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(47, 61, 54, 0.14);
  transition: background 0.28s ease, transform 0.2s ease;
}

.map-fab:active {
  transform: scale(0.92);
}

.home.is-map-full .map-fab {
  background: #6f9b88;
}

.day-sec {
  padding: 8rpx 4rpx 12rpx;
  font-size: 22rpx;
  color: #8a9a90;
  letter-spacing: 1rpx;
}

.empty-mini {
  margin: 0 0 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #9aa89f;
  font-size: 22rpx;
  text-align: center;
}

.days {
  white-space: nowrap;
  margin: 12rpx 0 8rpx;
  height: 72rpx;
}

.day-chip {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  position: relative;
  margin-right: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5d8a76;
  vertical-align: middle;
}

.day-chip.on {
  background: #6f9b88;
  color: #fff;
}

.day-n {
  font-size: 24rpx;
  font-weight: 650;
}

.day-d {
  font-size: 20rpx;
  opacity: 0.75;
}

.day-c {
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #e7f1eb;
  color: #5d8a76;
  font-size: 18rpx;
  text-align: center;
}

.day-chip.on .day-c {
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.tabs {
  display: flex;
  gap: 8rpx;
  margin: 4rpx 0 10rpx;
  padding: 4rpx;
  background: #e7f1eb;
  border-radius: 999rpx;
  max-height: 88rpx;
  overflow: hidden;
  transition: max-height 0.36s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, margin 0.36s cubic-bezier(0.22, 1, 0.36, 1), padding 0.36s cubic-bezier(0.22, 1, 0.36, 1);
}

.tabs.is-hide {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5d8a76;
}

.tab.on {
  background: #fff;
  color: #2f3d36;
  font-weight: 650;
}

.edit-banner {
  margin: 4rpx 0 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #eef6f1;
  color: #4f6f62;
  font-size: 22rpx;
  line-height: 1.4;
  max-height: 80rpx;
  overflow: hidden;
  transition: max-height 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, margin 0.32s, padding 0.32s;
}

.home.is-map-full .edit-banner {
  max-height: 0;
  opacity: 0;
  margin: 0;
  padding: 0;
}

.body-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  opacity: 1;
  transition: opacity 0.28s ease, flex-grow 0.42s cubic-bezier(0.22, 1, 0.36, 1);
}

.body-scroll.is-hide {
  flex-grow: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.body-scroll.with-bar .body-pad {
  padding-bottom: 48rpx;
}

.body-pad {
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

.fab-space {
  height: 120rpx;
}

.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 28rpx;
  text-align: center;
}

.empty-mark { font-size: 48rpx; margin-bottom: 8rpx; }
.empty-title { font-size: 28rpx; color: #2f3d36; font-weight: 650; }
.empty-sub { margin-top: 8rpx; margin-bottom: 28rpx; font-size: 22rpx; color: #8a9a90; }

.soft-btn {
  margin: 16rpx auto 0;
  max-width: 280rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4f6f62;
  background: #fff;
  border: 1rpx solid #d7e4dc;
}

.soft-btn.main {
  background: #6f9b88;
  color: #fff;
  border-color: #6f9b88;
}

.soft-btn.mini {
  margin: 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.soft-btn.ghost {
  background: transparent;
  border-color: transparent;
  color: #8a9a90;
}

.plan-list {
  padding-bottom: 8rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 12rpx 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 110, 96, 0.04);
}

.plan-row.is-start {
  background: #eef6f1;
  box-shadow: none;
}

.plan-row.lift {
  box-shadow: 0 16rpx 40rpx rgba(80, 110, 96, 0.14);
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.plan-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3d36;
}

.plan-type {
  flex-shrink: 0;
  margin-top: 2rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef6f1;
  color: #5d8a76;
  font-size: 20rpx;
  font-weight: 550;
  line-height: 1.4;
}

.plan-row.is-start .plan-type {
  background: rgba(111, 155, 136, 0.18);
}

.plan-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9a90;
}

.plan-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a6b3f;
  line-height: 1.4;
}

.plan-leg {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6f9b88;
  line-height: 1.4;
}

.plan-more {
  width: 52rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #9aa89f;
  font-size: 34rpx;
  flex-shrink: 0;
}

.plan-handle {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #b0bfb6;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.place-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 110, 96, 0.04);
}

.place-name {
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3d36;
}

.place-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9a90;
}

.stat-grid {
  display: flex;
  gap: 12rpx;
  margin: 0;
}

.stat-grid.two .stat {
  padding: 20rpx 24rpx;
  border: 1rpx solid transparent;
}

.stat {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 12rpx;
}

.stat.on {
  background: rgba(111, 155, 136, 0.12);
  border-color: rgba(111, 155, 136, 0.35);
}

.stat-k { font-size: 22rpx; color: #8a9a90; }
.stat-v {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 650;
  color: #2f3d36;
}

.stat.on .stat-v {
  color: #4f6f62;
}

.bill-hero {
  margin-bottom: 16rpx;
}

.settle-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 110, 96, 0.04);
}

.settle-tip {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #9aa89f;
  line-height: 1.5;
}

.settle-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3d36;
}

.settle-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9a90;
}

.settle-arrow {
  font-size: 36rpx;
  color: #b4c2ba;
  line-height: 1;
}

.cat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.cat {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #4f6f62;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 12rpx;
}

.list-title {
  font-size: 26rpx;
  font-weight: 650;
  color: #2f3d36;
}

.list-count {
  font-size: 22rpx;
  color: #9aa89f;
}

.list-add {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 550;
  color: #fff;
  background: #6f9b88;
}

.bill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bill-main { flex: 1; min-width: 0; }
.bill-amt-col {
  flex-shrink: 0;
  text-align: right;
}
.bill-amt {
  font-size: 30rpx;
  font-weight: 650;
  color: #6f9b88;
}
.bill-amt-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #9aa89f;
}

.invite-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 110, 96, 0.04);
}

.invite-left { flex: 1; min-width: 0; }

.invite-code {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 650;
  color: #2f3d36;
  letter-spacing: 4rpx;
}

.invite-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa89f;
}

.invite-copy {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 550;
  color: #4f6f62;
  background: #f3f6f3;
}

.member-tip {
  margin: -4rpx 4rpx 16rpx;
  font-size: 22rpx;
  color: #9aa89f;
  line-height: 1.5;
}

.group-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx 20rpx 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(80, 110, 96, 0.04);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.group-head-l {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.group-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #c5d4cb;
  flex-shrink: 0;
}

.group-dot.on {
  background: #6f9b88;
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #5d8a76;
}

.group-n {
  font-size: 22rpx;
  color: #9aa89f;
}

.member-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.m-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #f3f6f3;
  border: 1rpx solid transparent;
}

.m-chip.leader {
  background: rgba(111, 155, 136, 0.14);
  border-color: rgba(111, 155, 136, 0.28);
}

.m-chip.guest {
  background: #f7f4ef;
}

.m-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  background-color: #d7e4dc;
  flex-shrink: 0;
}

.m-avatar.letter {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 650;
  color: #4f6f62;
}

.m-name {
  font-size: 24rpx;
  color: #2f3d36;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-tag {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #6f9b88;
  background: rgba(111, 155, 136, 0.18);
}

.m-tag.soft {
  color: #8a9a90;
  background: rgba(138, 154, 144, 0.16);
}

.mgmt-card {
  margin-top: 28rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 110, 96, 0.04);
}

.mgmt-title {
  padding: 20rpx 0 8rpx;
  font-size: 22rpx;
  color: #9aa89f;
  letter-spacing: 1rpx;
}

.mgmt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef3ef;
}

.mgmt-row.last {
  border-bottom: none;
}

.mgmt-k {
  font-size: 28rpx;
  font-weight: 550;
  color: #2f3d36;
}

.mgmt-v {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9aa89f;
}

.danger-text { color: #c17b74; }

.danger { font-size: 24rpx; color: #c17b74; }

.invite {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fab-wrap {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 25;
}

.edit-bar {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(243, 246, 243, 0.98);
  box-shadow: 0 -6rpx 18rpx rgba(80, 110, 96, 0.06);
}

.edit-bar-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.edit-bar-btn.add {
  flex: 0.85;
  color: #4f6f62;
  background: #fff;
  border: 1rpx solid #d7e4dc;
}

.edit-bar-btn.ghost {
  flex: 0.95;
  color: #4f6f62;
  background: #fff;
  border: 1rpx solid #d7e4dc;
}

.edit-bar-btn.main {
  flex: 1.35;
  color: #fff;
  background: #6f9b88;
}
