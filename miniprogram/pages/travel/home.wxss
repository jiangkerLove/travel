page {
  height: 100%;
  background: #f4f9f6;
}

.home {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f4f9f6;
  overflow: hidden;
}

.top-fixed {
  flex-shrink: 0;
  padding: 8rpx 24rpx 0;
  background: #f4f9f6;
}

.hero {
  padding: 4rpx 4rpx 10rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 650;
  color: #2f3b35;
  line-height: 1.3;
}

.hero-edit {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #6cbfa6;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8fa19a;
  line-height: 1.3;
}

.hero-meta.dest {
  max-height: 40rpx;
  opacity: 1;
  overflow: hidden;
  transition: max-height 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, margin 0.32s cubic-bezier(0.22, 1, 0.36, 1);
}

.hero-meta.dest.is-hide {
  max-height: 0;
  opacity: 0;
  margin: 0;
}

.map-wrap {
  position: relative;
  border-radius: 20rpx;
  /* 不要 overflow:hidden 裁切原生 map，否则中间区域会一直闪 */
  background: #e9f6f0;
}

.day-map {
  width: 100%;
  display: block;
  border-radius: 20rpx;
}

.home.is-map-full .top-fixed {
  padding-bottom: 12rpx;
}

.map-fab {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(47, 61, 54, 0.14);
  transition: background 0.28s ease, transform 0.2s ease;
}

.map-fab:active {
  transform: scale(0.92);
}

.home.is-map-full .map-fab {
  background: #6cbfa6;
}

.day-sec {
  padding: 8rpx 4rpx 12rpx;
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 1rpx;
}

.empty-mini {
  margin: 0 0 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #97a8a1;
  font-size: 22rpx;
  text-align: center;
}

.days {
  white-space: nowrap;
  margin: 12rpx 0 8rpx;
  height: 72rpx;
}

.day-chip {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  position: relative;
  margin-right: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #4f9f8a;
  vertical-align: middle;
}

.day-chip.on {
  background: #6cbfa6;
  color: #fff;
}

.day-n {
  font-size: 24rpx;
  font-weight: 650;
}

.day-d {
  font-size: 20rpx;
  opacity: 0.75;
}

.day-c {
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #e9f6f0;
  color: #4f9f8a;
  font-size: 18rpx;
  text-align: center;
}

.day-chip.on .day-c {
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.tabs {
  display: flex;
  gap: 8rpx;
  margin: 4rpx 0 10rpx;
  padding: 4rpx;
  background: #e9f6f0;
  border-radius: 999rpx;
  max-height: 88rpx;
  overflow: hidden;
  transition: max-height 0.36s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, margin 0.36s cubic-bezier(0.22, 1, 0.36, 1), padding 0.36s cubic-bezier(0.22, 1, 0.36, 1);
}

.tabs.is-hide {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4f9f8a;
}

.tab.on {
  background: #fff;
  color: #2f3b35;
  font-weight: 650;
}

.edit-banner {
  margin: 4rpx 0 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #ecf6f1;
  color: #4f9f8a;
  font-size: 22rpx;
  line-height: 1.4;
  max-height: 80rpx;
  overflow: hidden;
  transition: max-height 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, margin 0.32s, padding 0.32s;
}

.edit-banner.has-act {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.edit-banner-act {
  flex-shrink: 0;
  font-weight: 650;
}

.home.is-map-full .edit-banner {
  max-height: 0;
  opacity: 0;
  margin: 0;
  padding: 0;
}

.body-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  opacity: 1;
  transition: opacity 0.28s ease, flex-grow 0.42s cubic-bezier(0.22, 1, 0.36, 1);
}

.body-scroll.is-hide {
  flex-grow: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.body-scroll.with-bar .body-pad {
  padding-bottom: 48rpx;
}

.body-pad {
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

.fab-space {
  height: 120rpx;
}

.empty-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 56rpx 28rpx;
  text-align: center;
}

.empty-mark { font-size: 48rpx; margin-bottom: 8rpx; }
.empty-title { font-size: 28rpx; color: #2f3b35; font-weight: 650; }
.empty-sub { margin-top: 8rpx; margin-bottom: 28rpx; font-size: 22rpx; color: #8fa19a; }

.soft-btn {
  margin: 16rpx auto 0;
  max-width: 280rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4f9f8a;
  background: #fff;
  border: 1rpx solid #d9ece3;
}

.soft-btn.main {
  background: #6cbfa6;
  color: #fff;
  border-color: #6cbfa6;
}

.soft-btn.mini {
  margin: 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.soft-btn.ghost {
  background: transparent;
  border-color: transparent;
  color: #8fa19a;
}

.plan-list {
  padding-bottom: 8rpx;
}

.plan-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 12rpx 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 191, 166, 0.07);
}

.plan-row.is-start {
  background: #ecf6f1;
  box-shadow: none;
}

.plan-row.lift {
  box-shadow: 0 16rpx 40rpx rgba(80, 110, 96, 0.14);
}

.plan-main {
  flex: 1;
  min-width: 0;
}

.plan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.plan-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3b35;
}

.plan-type {
  flex-shrink: 0;
  margin-top: 2rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ecf6f1;
  color: #4f9f8a;
  font-size: 20rpx;
  font-weight: 550;
  line-height: 1.4;
}

.plan-row.is-start .plan-type {
  background: rgba(111, 155, 136, 0.18);
}

.plan-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8fa19a;
}

.plan-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a6b3f;
  line-height: 1.4;
}

.plan-leg {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6cbfa6;
  line-height: 1.4;
}

.plan-more {
  width: 52rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #97a8a1;
  font-size: 34rpx;
  flex-shrink: 0;
}

.plan-handle {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #b5c7bf;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  flex-shrink: 0;
}

.place-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 191, 166, 0.07);
}

.place-name {
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3b35;
}

.place-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8fa19a;
}

.stat-grid {
  display: flex;
  gap: 12rpx;
  margin: 0;
}

.stat-grid.two .stat {
  padding: 20rpx 24rpx;
  border: 1rpx solid transparent;
}

.stat {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 12rpx;
}

.stat.on {
  background: rgba(111, 155, 136, 0.12);
  border-color: rgba(111, 155, 136, 0.35);
}

.stat-k { font-size: 22rpx; color: #8fa19a; }
.stat-v {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 650;
  color: #2f3b35;
}

.stat.on .stat-v {
  color: #4f9f8a;
}

.bill-hero {
  margin-bottom: 16rpx;
}

.settle-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 191, 166, 0.07);
}

.settle-tip {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #97a8a1;
  line-height: 1.5;
}

.settle-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3b35;
}

.settle-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8fa19a;
}

.settle-arrow {
  font-size: 36rpx;
  color: #b9ccc3;
  line-height: 1;
}

.cat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}

.cat {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #4f9f8a;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 12rpx;
}

.list-title {
  font-size: 26rpx;
  font-weight: 650;
  color: #2f3b35;
}

.list-count {
  font-size: 22rpx;
  color: #97a8a1;
}

.list-add {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 550;
  color: #fff;
  background: #6cbfa6;
}

.bill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bill-main { flex: 1; min-width: 0; }
.bill-amt-col {
  flex-shrink: 0;
  text-align: right;
}
.bill-amt {
  font-size: 30rpx;
  font-weight: 650;
  color: #6cbfa6;
}
.bill-amt-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #97a8a1;
}

.invite-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 191, 166, 0.07);
}

.invite-left { flex: 1; min-width: 0; }

.invite-code {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 650;
  color: #2f3b35;
  letter-spacing: 4rpx;
}

.invite-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #97a8a1;
}

.invite-copy {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 550;
  color: #4f9f8a;
  background: #f4f9f6;
}

.member-tip {
  margin: -4rpx 4rpx 16rpx;
  font-size: 22rpx;
  color: #97a8a1;
  line-height: 1.5;
}

.group-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx 20rpx 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(108, 191, 166, 0.07);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.group-head-l {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.group-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #cad9d1;
  flex-shrink: 0;
}

.group-dot.on {
  background: #6cbfa6;
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4f9f8a;
}

.group-n {
  font-size: 22rpx;
  color: #97a8a1;
}

.member-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.m-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #f4f9f6;
  border: 1rpx solid transparent;
}

.m-chip.leader {
  background: rgba(111, 155, 136, 0.14);
  border-color: rgba(108, 191, 166, 0.32);
}

.m-chip.guest {
  background: #f7f4ef;
}

.m-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  background-color: #d9ece3;
  flex-shrink: 0;
}

.m-avatar.letter {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 650;
  color: #4f9f8a;
}

.m-name {
  font-size: 24rpx;
  color: #2f3b35;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-tag {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #6cbfa6;
  background: rgba(111, 155, 136, 0.18);
}

.m-tag.soft {
  color: #8fa19a;
  background: rgba(138, 154, 144, 0.16);
}

.mgmt-card {
  margin-top: 28rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 191, 166, 0.07);
}

.mgmt-title {
  padding: 20rpx 0 8rpx;
  font-size: 22rpx;
  color: #97a8a1;
  letter-spacing: 1rpx;
}

.mgmt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf5f0;
}

.mgmt-row.last {
  border-bottom: none;
}

.mgmt-k {
  font-size: 28rpx;
  font-weight: 550;
  color: #2f3b35;
}

.mgmt-v {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #97a8a1;
}

.danger-text { color: #c17b74; }

.danger { font-size: 24rpx; color: #c17b74; }

.invite {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fab-wrap {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 25;
}

.edit-bar {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(243, 246, 243, 0.98);
  box-shadow: 0 -6rpx 18rpx rgba(108, 191, 166, 0.10);
}

.edit-bar-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.edit-bar-btn.ai {
  flex: 0.95;
  color: #3d5c4e;
  background: #e8f4ee;
  border: 1rpx solid #cfe6da;
}

.edit-bar-btn.add {
  flex: 0.8;
  color: #4f9f8a;
  background: #fff;
  border: 1rpx solid #d9ece3;
}

.edit-bar-btn.ghost {
  flex: 0.95;
  color: #4f9f8a;
  background: #fff;
  border: 1rpx solid #d9ece3;
}

.edit-bar-btn.main {
  flex: 1.15;
  color: #fff;
  background: #6cbfa6;
}

.ai-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(47, 59, 53, 0.36);
  display: flex;
  align-items: flex-end;
}

.ai-sheet {
  width: 100%;
  max-height: 86vh;
  background: #f7fbf8;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -10rpx 32rpx rgba(108, 191, 166, 0.12);
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.ai-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 28rpx 8rpx;
}

.ai-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2f3b35;
}

.ai-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8fa19a;
}

.ai-close {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #8fa19a;
}

.ai-body {
  max-height: calc(86vh - 120rpx);
  padding: 0 28rpx 28rpx;
  box-sizing: border-box;
}

.ai-scope {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 8rpx 28rpx 16rpx;
}

.ai-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #4f9f8a;
  font-size: 24rpx;
  font-weight: 650;
  border: 1rpx solid #d9ece3;
  vertical-align: middle;
}

.ai-chip.on {
  background: #6cbfa6;
  color: #fff;
  border-color: #6cbfa6;
}

.ai-hint {
  font-size: 24rpx;
  color: #6d8379;
  line-height: 1.55;
  margin-bottom: 16rpx;
}

.ai-input {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #d9ece3;
  font-size: 28rpx;
  color: #2f3b35;
  line-height: 1.5;
}

.ai-ph {
  color: #b3c4bc;
}

.ai-row {
  margin-top: 16rpx;
}

.ai-btn {
  text-align: center;
  padding: 20rpx 16rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.ai-btn.ghost {
  color: #4f9f8a;
  background: #fff;
  border: 1rpx solid #d9ece3;
}

.ai-btn.main {
  margin-top: 20rpx;
  color: #fff;
  background: #6cbfa6;
}

.ai-btn.main.tight {
  margin-top: 0;
  flex: 1.25;
}

.ai-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.ai-actions .ai-btn.ghost {
  flex: 1;
}

.ai-btn.off {
  opacity: 0.5;
}

.ai-preview {
  margin-top: 24rpx;
}

.ai-summary {
  font-size: 26rpx;
  color: #3d5c4e;
  line-height: 1.5;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #ecf6f1;
  margin-bottom: 16rpx;
}

.ai-day {
  padding: 12rpx 0 16rpx;
}

.ai-day-h {
