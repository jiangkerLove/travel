<view class="home" wx:if="{{trip.id}}">
  <view class="hero">
    <view class="hero-place">{{trip.destination}}</view>
    <view class="hero-name">{{trip.travel_name}}</view>
    <view class="hero-date">{{trip.start_date}} 至 {{trip.end_date}}</view>
  </view>

  <view class="tabs" wx:if="{{mode === 'edit'}}">
    <view class="tab {{tab === 'plan' ? 'on' : ''}}" bind:tap="setTab" data-v="plan">行程</view>
    <view class="tab {{tab === 'map' ? 'on' : ''}}" bind:tap="setTab" data-v="map">路书</view>
  </view>
  <view class="tabs" wx:else>
    <view class="tab {{tab === 'plan' ? 'on' : ''}}" bind:tap="setTab" data-v="plan">行程</view>
    <view class="tab {{tab === 'map' ? 'on' : ''}}" bind:tap="setTab" data-v="map">路书</view>
    <view class="tab {{tab === 'bill' ? 'on' : ''}}" wx:if="{{canBill}}" bind:tap="setTab" data-v="bill">账单</view>
    <view class="tab {{tab === 'member' ? 'on' : ''}}" bind:tap="setTab" data-v="member">成员</view>
  </view>

  <view wx:if="{{tab === 'plan'}}">
    <scroll-view scroll-x class="days" enhanced show-scrollbar="{{false}}">
      <view
        class="day-chip {{dayIndex === index ? 'on' : ''}}"
        wx:for="{{days}}"
        wx:key="day_num"
        bind:tap="switchDay"
        data-index="{{index}}"
      >
        <view class="day-n">D{{item.day_num}}</view>
        <view class="day-d">{{item.shortDate}}</view>
      </view>
    </scroll-view>

    <view class="plan-row is-start" wx:if="{{currentDay.startFrom}}">
      <view class="plan-main">
        <view class="plan-name">{{currentDay.startFrom.place_name}}</view>
        <view class="plan-sub">D{{currentDay.startFrom.day_num}} 停留 · 今天从这里出发</view>
      </view>
    </view>

    <view class="empty-card" wx:if="{{!currentDay.plans.length}}">
      <view class="empty-mark">🍃</view>
      <view class="empty-title">{{mode === 'edit' ? (currentDay.startFrom ? '接着往下排' : '这一天还是空的') : '这一天还没有行程'}}</view>
      <view class="empty-sub">{{mode === 'edit' ? (currentDay.startFrom ? '起点已接上昨天最后停留的地方' : '先选一个地点，再慢慢排') : '路线由团长或有权限的同伴来排'}}</view>
      <view class="soft-btn main" wx:if="{{mode === 'edit'}}" bind:tap="quickAddEnd">{{currentDay.startFrom ? '去下一站' : '开始选点'}}</view>
    </view>

    <view class="plan-list" wx:else>
      <view
        class="plan-row {{item.point_type === 'via' ? 'is-via' : ''}} {{dragIndex === index ? 'lift' : ''}}"
        wx:for="{{currentDay.plans}}"
        wx:key="id"
      >
        <view class="plan-main" bind:tap="editPlan" data-id="{{item.id}}">
          <view class="plan-name">{{item.place_name}}</view>
          <view class="plan-sub">{{item.typeLabel}}{{item.arriveText ? ' · ' + item.arriveText : ''}}</view>
        </view>
        <view
          class="plan-handle"
          wx:if="{{mode === 'edit'}}"
          catchtouchstart="onDragStart"
          catchtouchmove="onDragMove"
          catchtouchend="onDragEnd"
          catchtouchcancel="onDragEnd"
          data-index="{{index}}"
        >⋮⋮</view>
      </view>
    </view>

    <view class="fab-wrap" wx:if="{{mode === 'edit'}}">
      <t-fab icon="add" bind:click="quickAddEnd" />
    </view>
  </view>

  <view hidden="{{tab !== 'map'}}">
    <map
      id="routeMap"
      class="map"
      latitude="{{mapLat}}"
      longitude="{{mapLng}}"
      scale="8"
      markers="{{markers}}"
      polyline="{{polyline}}"
      bindmarkertap="onMarker"
    />
    <view class="place-card" wx:for="{{visiblePoints}}" wx:key="id" bind:tap="focusPoint" data-id="{{item.id}}">
      <view class="place-name">{{item.place_name}}</view>
      <view class="place-sub">D{{item.day_num}} · {{item.typeLabel}}{{item.legHint ? ' · ' + item.legHint : ''}}</view>
    </view>
  </view>

  <view wx:if="{{mode === 'browse' && canBill && tab === 'bill'}}">
    <view class="stat-grid">
      <view class="stat"><view class="stat-k">公共</view><view class="stat-v">¥{{stat.public_total || 0}}</view></view>
      <view class="stat"><view class="stat-k">我的</view><view class="stat-v">¥{{stat.private_total || 0}}</view></view>
      <view class="stat"><view class="stat-k">人均</view><view class="stat-v">¥{{stat.avg_public || 0}}</view></view>
    </view>
    <view class="place-card" wx:if="{{stat.categories && stat.categories.length}}">
      <view class="cat" wx:for="{{stat.categories}}" wx:key="cost_type">
        <text>{{item.label}}</text>
        <text>¥{{item.amount}}</text>
      </view>
    </view>
    <view class="soft-btn" bind:tap="goSettle">查看分账</view>
    <view class="place-card bill" wx:for="{{bills}}" wx:key="id" bind:tap="editBill" data-id="{{item.id}}">
      <view class="bill-row">
        <view class="bill-main">
          <view class="place-name">{{item.bill_name}}</view>
          <view class="place-sub">{{item.pay_nickname}} 付 · {{item.bill_type === 1 ? '集体' : '个人'}}</view>
        </view>
        <view class="bill-amt">¥{{item.amount}}</view>
      </view>
    </view>
    <view class="empty-card" wx:if="{{!bills.length}}">
      <view class="empty-title">还没有账单</view>
      <view class="empty-sub">餐饮购物都可以直接记</view>
    </view>
    <view class="fab-wrap">
      <t-fab icon="add" bind:click="addBill" />
    </view>
  </view>

  <view wx:if="{{mode === 'browse' && tab === 'member'}}">
    <view class="place-card invite">
      <view>
        <view class="stat-k">邀请码</view>
        <view class="hero-name" style="font-size: 40rpx">{{trip.invite_code}}</view>
      </view>
      <view class="soft-btn mini" bind:tap="copyCode">复制</view>
    </view>
    <view class="place-card member" wx:for="{{members}}" wx:key="user_id">
      <view class="member-top">
        <view class="member-main">
          <t-avatar size="small" image="{{item.avatar}}" />
          <view>
            <view class="place-name">{{item.nickname}}</view>
            <view class="place-sub">{{item.perm_text || item.role_text}}</view>
          </view>
        </view>
        <text class="danger" wx:if="{{trip.role === 1 && item.role !== 1}}" bind:tap="removeMember" data-id="{{item.user_id}}">移除</text>
      </view>
      <view class="perm-row" wx:if="{{trip.role === 1 && item.role !== 1}}">
        <view class="perm-chip {{item.can_edit ? 'on' : ''}}" catch:tap="togglePerm" data-id="{{item.user_id}}" data-k="can_edit">改行程</view>
        <view class="perm-chip {{item.can_bill ? 'on' : ''}}" catch:tap="togglePerm" data-id="{{item.user_id}}" data-k="can_bill">记账</view>
      </view>
    </view>
    <view class="soft-btn" wx:if="{{trip.role === 1}}" bind:tap="toggleLock">{{trip.is_lock ? '解锁结算' : '锁定结算'}}</view>
    <view class="soft-btn ghost" wx:if="{{trip.role === 1}}" bind:tap="archive">归档旅途</view>
    <view class="soft-btn ghost" wx:if="{{trip.role !== 1}}" bind:tap="quit">退出旅途</view>
  </view>
</view>
