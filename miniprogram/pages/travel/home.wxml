<view class="home {{mapExpanded ? 'is-map-full' : ''}} {{mode === 'edit' ? 'is-edit' : ''}}" wx:if="{{trip.id}}">
  <view class="top-fixed">
    <view class="hero">
      <view class="hero-title-row">
        <view class="hero-title">{{trip.travel_name}}</view>
        <view
          class="hero-edit"
          wx:if="{{mode === 'browse' && !trip.is_sample && trip.status !== 2 && (canEdit || trip.role === 1)}}"
          bind:tap="onTravelMgmt"
        >旅途管理</view>
      </view>
      <view class="hero-meta dest {{mapExpanded ? 'is-hide' : ''}}" wx:if="{{trip.destination}}">
        {{trip.destination}}<text wx:if="{{trip.start_date}}"> · {{trip.start_date}} – {{trip.end_date}}</text>
      </view>
      <view class="hero-meta" wx:if="{{trip.is_sample}}">示例攻略</view>
    </view>

    <view class="map-wrap" style="height: {{mapHeight}}px;">
      <map
        id="dayMap"
        class="day-map"
        style="height: {{mapHeight}}px;"
        latitude="{{mapLat}}"
        longitude="{{mapLng}}"
        scale="12"
        markers="{{markers}}"
        polyline="{{polyline}}"
        show-location="{{false}}"
        enable-poi="{{true}}"
        enable-3D="{{false}}"
        enable-overlooking="{{false}}"
        enable-traffic="{{false}}"
        enable-building="{{true}}"
        bindmarkertap="onMarker"
      />
      <view class="map-fab" catch:tap="toggleMapFull">
        <t-icon
          name="{{mapExpanded ? 'fullscreen-exit' : 'fullscreen-2'}}"
          size="40rpx"
          color="{{mapExpanded ? '#ffffff' : '#3d5c4e'}}"
        />
      </view>
    </view>

    <scroll-view scroll-x class="days" show-scrollbar="{{false}}">
      <view
        class="day-chip {{mapScope === 'all' ? 'on' : ''}}"
        bind:tap="switchAll"
      >
        <text class="day-n">全程</text>
      </view>
      <view
        class="day-chip {{mapScope === 'day' && dayIndex === index ? 'on' : ''}}"
        wx:for="{{days}}"
        wx:key="day_num"
        bind:tap="switchDay"
        data-index="{{index}}"
      >
        <text class="day-n">D{{item.day_num}}</text>
        <text class="day-d">{{item.shortDate}}</text>
        <text class="day-c" wx:if="{{item.plans.length}}">{{item.plans.length}}</text>
      </view>
    </scroll-view>

    <view class="tabs {{mapExpanded ? 'is-hide' : ''}}" wx:if="{{mode === 'browse'}}">
      <view class="tab {{tab === 'plan' ? 'on' : ''}}" bind:tap="setTab" data-v="plan">行程</view>
      <view class="tab {{tab === 'bill' ? 'on' : ''}}" bind:tap="setTab" data-v="bill">账单</view>
      <view class="tab {{tab === 'member' ? 'on' : ''}}" bind:tap="setTab" data-v="member">成员</view>
    </view>
    <view class="edit-banner has-act" wx:elif="{{aiPending}}">
      <text class="edit-banner-txt">{{aiIntro}}</text>
      <text class="edit-banner-act" catch:tap="cancelAi">取消</text>
    </view>
    <view class="edit-banner" wx:elif="{{!routesReady}}">
      <text>排点中 · 预览后看路线与用时</text>
    </view>
  </view>

  <scroll-view
    class="body-scroll {{mode === 'edit' ? 'with-bar' : ''}} {{mapExpanded ? 'is-hide' : ''}}"
    scroll-y
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{tab === 'plan' || mode === 'edit'}}" class="body-pad">
      <!-- 全程预览 -->
      <block wx:if="{{mapScope === 'all'}}">
        <view class="empty-card" wx:if="{{!days.length}}">
          <view class="empty-title">还没有行程</view>
        </view>
        <block wx:for="{{days}}" wx:for-item="day" wx:key="day_num">
          <view class="day-sec">D{{day.day_num}} · {{day.shortDate}}</view>
          <view class="empty-mini" wx:if="{{!day.plans.length}}">这一天还空着</view>
          <view class="plan-list" wx:else>
            <view
              class="plan-row"
              wx:for="{{day.plans}}"
              wx:for-item="p"
              wx:key="id"
            >
              <view class="plan-main" bind:tap="editPlan" data-id="{{p.id}}">
                <view class="plan-head">
                  <view class="plan-name">{{p.place_name}}</view>
                  <view class="plan-type">{{p.typeLabel}}</view>
                </view>
                <view class="plan-leg" wx:if="{{p.arriveText}}">到这里 · {{p.arriveText}}</view>
              </view>
            </view>
          </view>
        </block>
        <view class="fab-space" wx:if="{{mode === 'edit'}}"></view>
      </block>

      <!-- 单日 -->
      <block wx:else>
        <view class="empty-card" wx:if="{{!currentDay.plans.length}}">
          <view class="plan-row is-start" wx:if="{{currentDay.startFrom}}">
            <view class="plan-main">
              <view class="plan-head">
                <view class="plan-name">{{currentDay.startFrom.place_name}}</view>
                <view class="plan-type">出发</view>
              </view>
              <view class="plan-sub">D{{currentDay.startFrom.day_num}} 停留 · 今天从这里出发</view>
            </view>
          </view>
          <view class="empty-mark">🍃</view>
          <view class="empty-title">{{mode === 'edit' ? (currentDay.startFrom ? '接着往下排' : '这一天还是空的') : '这一天还没有行程'}}</view>
          <view class="empty-sub">{{mode === 'edit' ? (currentDay.startFrom ? '起点已接上昨天最后停留的地方' : '先选地点，可随时移到其他天') : '路线由团长或有权限的同伴来排'}}</view>
          <view class="soft-btn main" wx:if="{{mode === 'edit'}}" bind:tap="quickAddEnd">{{currentDay.startFrom ? '去下一站' : '开始选点'}}</view>
        </view>

        <view class="plan-list" wx:else>
          <view class="plan-row is-start" wx:if="{{currentDay.startFrom}}">
            <view class="plan-main">
              <view class="plan-head">
                <view class="plan-name">{{currentDay.startFrom.place_name}}</view>
                <view class="plan-type">出发</view>
              </view>
              <view class="plan-sub">D{{currentDay.startFrom.day_num}} 停留 · 今天从这里出发</view>
            </view>
          </view>
          <view
            class="plan-row {{dragIndex === index ? 'lift' : ''}} {{index === 0 && !currentDay.startFrom ? 'is-start' : ''}}"
            wx:for="{{currentDay.plans}}"
            wx:key="id"
          >
            <view class="plan-main" bind:tap="editPlan" data-id="{{item.id}}">
              <view class="plan-head">
                <view class="plan-name">{{index === 0 && !currentDay.startFrom ? '起点 · ' : ''}}{{item.place_name}}</view>
                <view class="plan-type">{{item.typeLabel}}</view>
              </view>
              <view class="plan-sub" wx:if="{{index === 0 && !currentDay.startFrom && !item.latitude}}">还没标坐标</view>
              <view class="plan-leg" wx:if="{{item.arriveText && (index > 0 || currentDay.startFrom)}}">到这里 · {{item.arriveText}}</view>
              <view class="plan-tip" wx:if="{{item.remark}}">{{item.remark}}</view>
            </view>
            <view
              class="plan-more"
              wx:if="{{mode === 'edit'}}"
              catch:tap="onMorePlan"
              data-id="{{item.id}}"
            >⋯</view>
            <view
              class="plan-handle"
              wx:if="{{mode === 'edit'}}"
              catchtouchstart="onDragStart"
              catchtouchmove="onDragMove"
              catchtouchend="onDragEnd"
              catchtouchcancel="onDragEnd"
              data-index="{{index}}"
            >⋮⋮</view>
          </view>
        </view>

        <view class="fab-space" wx:if="{{mode === 'edit'}}"></view>
      </block>
    </view>

    <view wx:if="{{mode === 'browse' && tab === 'bill'}}" class="body-pad">
      <view class="bill-hero">
        <view class="stat-grid two">
          <view class="stat {{billView === 'pool' ? 'on' : ''}}" bind:tap="setBillView" data-v="pool">
            <view class="stat-k">账单池</view>
            <view class="stat-v">¥{{stat.public_total || 0}}</view>
          </view>
          <view class="stat {{billView === 'mine' ? 'on' : ''}}" bind:tap="setBillView" data-v="mine">
            <view class="stat-k">我的花销</view>
            <view class="stat-v">¥{{stat.private_total || 0}}</view>
          </view>
        </view>
        <view class="settle-entry" wx:if="{{mapScope === 'all' && trip.status === 2}}" bind:tap="goSettle">
          <view>
            <view class="settle-title">智能分账</view>
            <view class="settle-sub">已归档 · 按人或团体看该转多少</view>
          </view>
          <text class="settle-arrow">›</text>
        </view>
        <view class="settle-tip" wx:elif="{{mapScope === 'all' && !trip.is_sample}}">归档后可查看智能分账</view>
      </view>

      <view class="cat-card" wx:if="{{billView === 'pool' && stat.categories && stat.categories.length}}">
        <view class="cat" wx:for="{{stat.categories}}" wx:key="cost_type">
          <text>{{item.label}}</text>
          <text>¥{{item.amount}}</text>
        </view>
      </view>

      <view class="list-head">
        <view class="list-title">{{billListTitle}}</view>
        <view class="list-count" wx:if="{{bills.length}}">{{bills.length}} 笔</view>
      </view>

      <view class="place-card bill" wx:for="{{bills}}" wx:key="id" bind:tap="editBill" data-id="{{item.id}}">
        <view class="bill-row">
          <view class="bill-main">
            <view class="place-name">{{item.bill_name}}</view>
            <view class="place-sub">
              {{item.pay_nickname}} 付{{item.share_hint ? ' · ' + item.share_hint : ''}}{{item.cost_type_label ? ' · ' + item.cost_type_label : ''}}{{item.plan_place_name ? ' · ' + item.plan_place_name : ''}}
            </view>
          </view>
          <view class="bill-amt-col">
            <view class="bill-amt">¥{{item.display_amount}}</view>
            <view class="bill-amt-sub" wx:if="{{item.display_sub}}">{{item.display_sub}}</view>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:if="{{!bills.length}}">
        <view class="empty-title">{{billEmptyTitle}}</view>
        <view class="empty-sub">{{billEmptySub}}</view>
      </view>
      <view class="fab-space"></view>
    </view>

    <view wx:if="{{mode === 'browse' && tab === 'member'}}" class="body-pad">
      <view class="invite-card">
        <view class="invite-left">
          <view class="stat-k">邀请码</view>
          <view class="invite-code">{{trip.invite_code}}</view>
          <view class="invite-hint">好友输入邀请码即可加入</view>
        </view>
        <view class="invite-copy" bind:tap="copyCode">复制</view>
      </view>

      <view class="list-head">
        <view class="list-title">成员与团体</view>
        <view
          class="list-add"
          wx:if="{{!trip.is_sample && trip.status !== 2 && trip.role === 1}}"
          bind:tap="addCompanion"
        >＋ 随行</view>
      </view>
      <view class="member-tip">点成员可设置团体与权限</view>

      <view class="group-card" wx:for="{{memberGroups}}" wx:key="key">
        <view class="group-head">
          <view class="group-head-l">
            <text class="group-dot {{item.isGroup ? 'on' : ''}}"></text>
            <text class="group-title">{{item.title}}</text>
          </view>
          <text class="group-n">{{item.members.length}}</text>
        </view>
        <view class="member-wrap">
          <view
            class="m-chip {{m.role === 1 ? 'leader' : ''}} {{m.is_guest ? 'guest' : ''}}"
            wx:for="{{item.members}}"
            wx:for-item="m"
            wx:key="user_id"
            bind:tap="onMemberTap"
            data-id="{{m.user_id}}"
          >
            <view class="m-avatar" wx:if="{{m.avatar}}" style="background-image:url({{m.avatar}})"></view>
            <view class="m-avatar letter" wx:else>{{m.nickLetter}}</view>
            <text class="m-name">{{m.nickname}}</text>
            <text class="m-tag" wx:if="{{m.role === 1}}">团</text>
            <text class="m-tag soft" wx:elif="{{m.can_edit || m.can_bill}}">权</text>
          </view>
        </view>
      </view>

      <view class="empty-card" wx:if="{{!members.length}}">
        <view class="empty-title">还没有成员</view>
        <view class="empty-sub">分享邀请码，或添加随行成员</view>
      </view>

      <view class="mgmt-card" wx:if="{{!trip.is_sample && trip.status !== 2 && trip.role !== 1}}">
        <view class="mgmt-row last" bind:tap="quit">
          <view>
            <view class="mgmt-k danger-text">退出旅途</view>
            <view class="mgmt-v">退出后不再看到本团账单</view>
          </view>
          <text class="settle-arrow">›</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="fab-wrap" wx:if="{{mode === 'browse' && canBill && tab === 'bill'}}">
    <t-fab icon="add" bind:click="addBill" />
  </view>

  <view class="edit-bar" wx:if="{{mode === 'edit' && aiPending}}">
    <view class="edit-bar-btn ghost" bind:tap="cancelAi">取消</view>
    <view class="edit-bar-btn add" bind:tap="openAi">再生成</view>
    <view class="edit-bar-btn main" bind:tap="keepAi">保存</view>
  </view>
  <view class="edit-bar" wx:elif="{{mode === 'edit'}}">
    <view class="edit-bar-btn ai" bind:tap="openAi">AI 排程</view>
    <view class="edit-bar-btn add" bind:tap="quickAddEnd">＋ 地点</view>
    <view class="edit-bar-btn ghost" bind:tap="generateRoutes">{{routesReady ? '重预览' : '预览'}}</view>
    <view class="edit-bar-btn main" bind:tap="finishEdit">完成</view>
  </view>

  <view class="ai-mask" wx:if="{{aiOpen}}" catch:tap="onAiMask">
    <view class="ai-sheet" style="margin-bottom: {{aiKb}}px;" catch:tap="onAiSheetTap">
      <view class="ai-head">
        <view>
          <view class="ai-title">AI 排行程</view>
          <view class="ai-sub" wx:if="{{trip.start_date}}">{{trip.start_date}} – {{trip.end_date}} · {{days.length}} 天</view>
        </view>
        <view class="ai-close" catch:tap="closeAi">收起</view>
      </view>
      <view class="ai-scope">
        <view class="ai-chip {{aiMode !== 'recommend' ? 'on' : ''}}" catch:tap="setAiMode" data-mode="plan">重排行程</view>
        <view class="ai-chip {{aiMode === 'recommend' ? 'on' : ''}}" catch:tap="setAiMode" data-mode="recommend">沿途推荐</view>
      </view>
      <view class="ai-scope">
        <view class="ai-chip {{aiDayNum === 0 ? 'on' : ''}}" catch:tap="setAiDay" data-scope="all">全程</view>
        <view
          class="ai-chip {{aiDayNum === item.day_num ? 'on' : ''}}"
          wx:for="{{days}}"
          wx:key="day_num"
          catch:tap="setAiDay"
          data-scope="{{item.day_num}}"
        >D{{item.day_num}}</view>
      </view>
      <view class="ai-body">
        <view class="ai-hint" wx:if="{{aiMode === 'recommend'}}">不改现在的走法，只在路线附近推荐景点。可以写偏好，也可以直接推荐。</view>
        <view class="ai-hint" wx:elif="{{aiDayNum === 0}}">写要去哪或粘贴链接，会按你的描述全新排一版，不沿用现在的地点。第一版之后再生成，才会在上一版上改。</view>
        <view class="ai-hint" wx:else>只改 D{{aiDayNum}}。第一版按你的描述重排；之后再生成才基于上一版加减。</view>
        <textarea
          class="ai-input"
          value="{{aiPrompt}}"
          maxlength="2000"
          placeholder="{{aiMode === 'recommend' ? '例如：想多看古镇，或只要顺路、别太累（可不填）' : (aiDayNum === 0 ? '例如：去川西，要去四姑娘山和丹巴，不去新都桥' : '例如：这天加上洱海日落，去掉喜洲')}}"
          placeholder-class="ai-ph"
          adjust-position="{{false}}"
          cursor-spacing="24"
          hold-keyboard="{{true}}"
          show-confirm-bar="{{false}}"
          bindinput="onAiPrompt"
          bindkeyboardheightchange="onAiKeyboard"
        />
        <view class="ai-row">
          <view class="ai-btn main tight {{aiLoading ? 'off' : ''}}" catch:tap="runAiDraft">{{aiMode === 'recommend' ? '推荐并预览' : (aiDayNum ? '生成这一天' : '生成并预览')}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="ai-mask" wx:if="{{dayPickOpen}}" catch:tap="closeDayPick">
    <view class="ai-sheet day-pick-sheet" catch:tap="onAiSheetTap">
      <view class="ai-head">
        <view class="ai-title">{{dayPickTitle}}</view>
        <view class="ai-close" catch:tap="closeDayPick">取消</view>
      </view>
      <scroll-view scroll-y class="day-pick-list" enhanced show-scrollbar="{{false}}">
        <view
          class="day-pick-row {{item.disabled ? 'off' : ''}}"
          wx:for="{{dayPickDays}}"
          wx:key="day_num"
          catch:tap="onPickDay"
          data-day="{{item.day_num}}"
        >
          <view>
            <view class="day-pick-n">D{{item.day_num}} · {{item.shortDate}}</view>
            <view class="day-pick-s">{{item.hint}}</view>
          </view>
          <text class="settle-arrow" wx:if="{{!item.disabled}}">›</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
