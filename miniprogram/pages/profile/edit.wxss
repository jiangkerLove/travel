page {
  background: #f4f9f6;
}

.edit-page {
  min-height: 100vh;
  padding: 28rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(108, 191, 166, 0.07);
}

.cell {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #2f3b35;
}

.cell-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.avatar-btn {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
  line-height: 0;
}
.avatar-btn::after { border: none; }

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e9f6f0;
  display: block;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #4f9f8a;
  font-size: 30rpx;
  font-weight: 650;
}

.nick {
  flex: 1;
  height: 64rpx;
  font-size: 30rpx;
  color: #2f3b35;
  text-align: right;
}

.ph {
  color: #b9ccc3;
}

.line {
  height: 1rpx;
  margin-left: 28rpx;
  background: #edf5f0;
}

.later {
  margin-top: 24rpx;
}

.later picker {
  display: block;
}

.val {
  font-size: 30rpx;
  color: #2f3b35;
}

.chev {
  color: #c8d6cf;
  font-size: 36rpx;
  line-height: 1;
  margin-left: 8rpx;
}

.hint {
  margin: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: #97a8a1;
  line-height: 1.6;
}

.save {
  margin-top: 48rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #6cbfa6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(108, 191, 166, 0.32);
}

.save.disabled {
  opacity: 0.4;
  box-shadow: none;
}
