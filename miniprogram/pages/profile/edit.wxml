<view class="edit-page">
  <view class="card">
    <view class="cell">
      <text class="label">头像</text>
      <view class="cell-right">
        <button
          class="avatar-btn"
          open-type="chooseAvatar"
          hover-class="none"
          bindchooseavatar="onChooseAvatar"
        >
          <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
          <view wx:else class="avatar fallback">{{initial}}</view>
        </button>
      </view>
    </view>
    <view class="line"></view>
    <view class="cell">
      <text class="label">昵称</text>
      <input
        class="nick"
        type="nickname"
        placeholder="请输入昵称"
        placeholder-class="ph"
        value="{{nickname}}"
        maxlength="20"
        bindinput="onNickInput"
        bindchange="onNickChange"
      />
    </view>
  </view>

  <view class="card later">
    <picker mode="date" value="{{birthdayValue}}" start="1920-01-01" end="{{today}}" bindchange="onBirthday">
      <view class="cell">
        <text class="label">出生日期</text>
        <view class="cell-right">
          <text class="val {{birthday ? '' : 'ph'}}">{{birthdayText || '请选择'}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </picker>
    <view class="line"></view>
    <picker mode="selector" range="{{genderRange}}" value="{{genderIndex}}" bindchange="onGender">
      <view class="cell">
        <text class="label">性别</text>
        <view class="cell-right">
          <text class="val {{genderLabel ? '' : 'ph'}}">{{genderLabel || '请选择'}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </picker>
    <block wx:if="{{gender === 2}}">
      <view class="line"></view>
      <picker mode="selector" range="{{roleRange}}" value="{{femaleRole}}" bindchange="onRole">
        <view class="cell">
          <text class="label">岗位</text>
          <view class="cell-right">
            <text class="val">{{roleLabel}}</text>
            <text class="chev">›</text>
          </view>
        </view>
      </picker>
    </block>
    <view class="line"></view>
    <picker mode="date" fields="month" value="{{workMonthValue}}" start="1960-01" end="{{workMonthEnd}}" bindchange="onWorkMonth">
      <view class="cell">
        <text class="label">参加工作</text>
        <view class="cell-right">
          <text class="val {{workStartYear ? '' : 'ph'}}">{{workStartText || '选填，统计已工作时长'}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </picker>
  </view>
  <view class="hint">出生日期和性别用于计算退休年龄、剩余假期和还需工作天数。女职工按原 50 岁、女干部按原 55 岁对照渐进式延迟退休。</view>

  <view class="save {{dirty ? '' : 'disabled'}}" bind:tap="onSave">保存</view>
</view>
