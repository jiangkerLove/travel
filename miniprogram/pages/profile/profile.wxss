page {
  background: #f3f6f3;
}

.me-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: #f3f6f3;
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.user-card-hover {
  background: #f8fbf8;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #e7f1eb;
  flex-shrink: 0;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d8a76;
  font-size: 40rpx;
  font-weight: 650;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nick {
  font-size: 34rpx;
  font-weight: 650;
  color: #2f3d36;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a9a90;
}

.arrow {
  color: #c5d0c9;
  font-size: 40rpx;
  line-height: 1;
  margin-left: 8rpx;
}

.life-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 8rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.life-head {
  padding: 0 20rpx 16rpx;
  font-size: 24rpx;
  color: #8a9a90;
  letter-spacing: 4rpx;
}

.life-grid {
  display: flex;
  flex-wrap: wrap;
}

.life-item {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx 24rpx 28rpx;
}

.life-k {
  font-size: 22rpx;
  color: #8a9a90;
}

.life-v {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 650;
  color: #2f3d36;
  line-height: 1.25;
}

.life-v.muted {
  font-weight: 500;
  color: #b4c2ba;
}

.life-s {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa89f;
  line-height: 1.4;
}

.life-rows {
  margin: 4rpx 20rpx 16rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #eef3ef;
}

.life-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 4rpx;
}

.life-row-k {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8a9a90;
}

.life-row-v {
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: #4f6f62;
  line-height: 1.4;
}

.menu {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
}

.menu-item-hover {
  background: #f6faf7;
}

.menu-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #e7f1eb;
  color: #5d8a76;
  font-size: 24rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #2f3d36;
}

.menu-arrow {
  color: #c5d0c9;
  font-size: 40rpx;
  line-height: 1;
}

.menu-btn {
  width: 100%;
  margin: 0;
  padding: 28rpx 24rpx;
  background: transparent;
  text-align: left;
  line-height: inherit;
  font-size: inherit;
  border-radius: 20rpx;
  box-sizing: border-box;
}
.menu-btn::after { border: none; }

.menu-line {
  height: 1rpx;
  margin-left: 100rpx;
  margin-right: 24rpx;
  background: #eef3ef;
}
