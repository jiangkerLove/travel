page {
  background: #f3f6f3;
}

.me-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: #f3f6f3;
  box-sizing: border-box;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.user-card-hover {
  background: #f8fbf8;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #e7f1eb;
  flex-shrink: 0;
}

.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d8a76;
  font-size: 40rpx;
  font-weight: 650;
}

.user-meta {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nick {
  font-size: 34rpx;
  font-weight: 650;
  color: #2f3d36;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: #c5d0c9;
  font-size: 40rpx;
  line-height: 1;
  margin-left: 8rpx;
}

.menu {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
}

.menu-item-hover {
  background: #f6faf7;
}

.menu-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #e7f1eb;
  color: #5d8a76;
  font-size: 24rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #2f3d36;
}

.menu-arrow {
  color: #c5d0c9;
  font-size: 40rpx;
  line-height: 1;
}

.menu-btn {
  width: 100%;
  margin: 0;
  padding: 28rpx 24rpx;
  background: transparent;
  text-align: left;
  line-height: inherit;
  font-size: inherit;
  border-radius: 20rpx;
  box-sizing: border-box;
}
.menu-btn::after { border: none; }

.menu-line {
  height: 1rpx;
  margin-left: 100rpx;
  margin-right: 24rpx;
  background: #eef3ef;
}
