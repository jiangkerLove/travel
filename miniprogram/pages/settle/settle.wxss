page {
  background: #f4f9f6;
}

.settle-page {
  min-height: 100vh;
  padding: 20rpx 28rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 80% 45% at 0% -5%, rgba(111, 155, 136, 0.12), transparent 55%),
    #f4f9f6;
}

.intro {
  margin-bottom: 20rpx;
  padding: 8rpx 8rpx 4rpx;
}

.intro-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3b35;
}

.intro-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8fa19a;
  line-height: 1.5;
}

.sec-title {
  margin: 20rpx 8rpx 14rpx;
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 1rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(108, 191, 166, 0.07);
}

.card.nested {
  margin-left: 0;
  background: #f4f9f6;
  box-shadow: none;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 650;
  color: #2f3b35;
}

.muted {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #97a8a1;
  line-height: 1.4;
}

.names {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8fa19a;
  line-height: 1.5;
}

.amount {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 650;
}

.amount.in { color: #008858; }
.amount.out { color: #e37318; }

.empty {
  margin: 0 0 16rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #97a8a1;
  background: #fff;
  border-radius: 24rpx;
}

.empty.soft {
  background: transparent;
  padding: 12rpx 8rpx 20rpx;
}

.inner-block {
  margin-bottom: 12rpx;
}

.inner-head {
  margin: 4rpx 8rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4f9f8a;
}

.soft-btn {
  margin-top: 32rpx;
  padding: 26rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4f9f8a;
  background: #fff;
  border: 1rpx solid #d9ece3;
}

.soft-btn.main {
  background: #6cbfa6;
  color: #fff;
  border-color: #6cbfa6;
}
