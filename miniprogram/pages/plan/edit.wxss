page {
  background: #f4f9f6;
}

.edit-page {
  min-height: 100vh;
  box-sizing: border-box;
}

.search-screen {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: #f4f9f6;
}

.search-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 32rpx 8rpx;
}

.search-bar {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
}

.search-input {
  height: 80rpx;
  font-size: 32rpx;
  color: #2f3b35;
}

.search-ph {
  color: #b5c7bf;
  font-size: 32rpx;
}

.search-cancel {
  flex-shrink: 0;
  padding: 12rpx 4rpx;
  font-size: 28rpx;
  color: #4f9f8a;
}

.search-list {
  flex: 1;
  height: calc(100vh - 120rpx);
  margin-top: 8rpx;
  background: #fff;
}

.search-blank {
  padding: 160rpx 48rpx 0;
  text-align: center;
}

.blank-title {
  font-size: 34rpx;
  font-weight: 650;
  color: #2f3b35;
}

.blank-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8fa19a;
}

.poi {
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid #edf5f0;
}

.poi-hover {
  background: #f4f9f6;
}

.poi-name {
  font-size: 32rpx;
  color: #2f3b35;
  line-height: 1.4;
}

.poi-addr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8fa19a;
  line-height: 1.4;
}

.rest {
  padding: 24rpx 32rpx 80rpx;
}

.picked-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.picked-main {
  flex: 1;
  min-width: 0;
}

.picked-k {
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 2rpx;
}

.picked-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 650;
  color: #2f3b35;
}

.picked-addr {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4f9f8a;
  line-height: 1.5;
}

.picked-change {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6cbfa6;
}

.map-shell {
  margin-top: 20rpx;
  height: 360rpx;
  background: #e9f6f0;
}

.pick-map {
  width: 100%;
  height: 360rpx;
}

.form-card {
  margin-top: 20rpx;
  padding: 28rpx 28rpx 8rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.04);
}

.form-title {
  font-size: 30rpx;
  font-weight: 650;
  color: #2f3b35;
}

.block-label {
  margin: 28rpx 0 16rpx;
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 3rpx;
}

.chip-hint {
  margin: -8rpx 0 14rpx;
  font-size: 22rpx;
  color: #b9ccc3;
  line-height: 1.4;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f9f6;
  color: #4f9f8a;
  font-size: 24rpx;
}

.chip.on {
  background: #6cbfa6;
  color: #fff;
}

.field {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 8rpx;
  min-height: 88rpx;
  border-top: 1rpx solid #edf5f0;
}

.field-k {
  width: 140rpx;
  font-size: 28rpx;
  color: #2f3b35;
  flex-shrink: 0;
}

.field-v {
  flex: 1;
  font-size: 28rpx;
  color: #2f3b35;
}

.field-ph {
  color: #97a8a1;
  font-size: 24rpx;
}

.field-unit {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8fa19a;
}

.save-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #6cbfa6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.del-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #c17b74;
  font-size: 28rpx;
}
