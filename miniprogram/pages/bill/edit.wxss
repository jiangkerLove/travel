page {
  background: #f4f9f6;
}

.bill-page {
  min-height: 100vh;
  padding: 20rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 80% 45% at 0% -5%, rgba(111, 155, 136, 0.14), transparent 55%),
    #f4f9f6;
}

.type-switch {
  display: flex;
  padding: 6rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(80, 110, 96, 0.04);
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #8fa19a;
}

.type-item.on {
  background: #6cbfa6;
  color: #fff;
  font-weight: 650;
}

.amount-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(80, 110, 96, 0.05);
}

.amount-label {
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 1rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.yen {
  font-size: 40rpx;
  font-weight: 650;
  color: #6cbfa6;
  margin-right: 8rpx;
}

.amount-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: 650;
  color: #2f3b35;
  height: 72rpx;
  line-height: 72rpx;
}

.name-input {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf5f0;
  font-size: 28rpx;
  color: #2f3b35;
  height: 48rpx;
}

.sec-label {
  margin: 8rpx 8rpx 14rpx;
  font-size: 22rpx;
  color: #8fa19a;
  letter-spacing: 1rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.chip-row.tight {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4f9f8a;
  background: #fff;
  border: 1rpx solid #e6f2ec;
}

.chip.on {
  background: #6cbfa6;
  color: #fff;
  border-color: #6cbfa6;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(80, 110, 96, 0.04);
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf5f0;
}

.field {
  padding: 22rpx 0 8rpx;
}

.field.last {
  border-bottom: none;
}

.field-k {
  font-size: 26rpx;
  color: #8fa19a;
}

.field-v {
  font-size: 28rpx;
  color: #2f3b35;
  font-weight: 550;
}

.opt {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #b9ccc3;
  font-weight: 400;
}

.area {
  width: 100%;
  margin-top: 12rpx;
  min-height: 80rpx;
  font-size: 28rpx;
  color: #2f3b35;
  line-height: 1.5;
}

.ph {
  color: #b9ccc3;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #2f3b35;
}

.sec-act {
  font-size: 24rpx;
  color: #6cbfa6;
  font-weight: 550;
}

.muted {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #97a8a1;
  line-height: 1.4;
}

.share-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.share-chip {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 140rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #f4f9f6;
  color: #4f9f8a;
  font-size: 26rpx;
  border: 1rpx solid transparent;
}

.share-chip.on {
  background: rgba(111, 155, 136, 0.14);
  border-color: #6cbfa6;
  color: #2f3b35;
  font-weight: 550;
}

.share-g {
  font-size: 20rpx;
  color: #97a8a1;
  font-weight: 400;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0 10rpx;
}

.bottom-space {
  height: 20rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(243, 246, 243, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(80, 110, 96, 0.06);
}

.bar-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 16rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.bar-btn.ghost {
  flex: 0.7;
  color: #c17b74;
  background: #fff;
  border: 1rpx solid #edd9d5;
}

.bar-btn.main {
  flex: 1.4;
  color: #fff;
  background: #6cbfa6;
  box-shadow: 0 10rpx 24rpx rgba(111, 155, 136, 0.28);
}
