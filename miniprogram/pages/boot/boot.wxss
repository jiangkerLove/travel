.boot {
  min-height: 100vh;
  background: #f3f6f3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  border-radius: 36rpx;
  background: #6f9b88;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}
.h1 {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 650;
  color: #2f3d36;
}
.sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a9a90;
}
.err {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #8a6a62;
  text-align: center;
  line-height: 1.6;
}
.retry {
  margin-top: 40rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #6f9b88;
  color: #fff;
  font-size: 28rpx;
}
