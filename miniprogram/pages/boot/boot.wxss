.boot {
  min-height: 100vh;
  background:
    radial-gradient(ellipse 80% 50% at 10% -10%, rgba(111, 155, 136, 0.18), transparent 55%),
    #f3f6f3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.mark {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
}

.brand {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 650;
  color: #2f3d36;
  letter-spacing: 3rpx;
}

.sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a9a90;
}

.err {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #8a6a62;
  text-align: center;
  line-height: 1.6;
}

.retry {
  margin-top: 40rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #6f9b88;
  color: #fff;
  font-size: 28rpx;
}
