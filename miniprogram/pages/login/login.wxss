page {
  background: #f4f9f6;
}

.entry {
  min-height: 100vh;
  padding: 160rpx 40rpx 64rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 90% 55% at 12% -8%, rgba(111, 155, 136, 0.22), transparent 58%),
    radial-gradient(ellipse 70% 45% at 100% 8%, rgba(215, 228, 220, 0.95), transparent 52%),
    #f4f9f6;
}

.hero {
  text-align: center;
  margin-bottom: 56rpx;
}

.mark {
  width: 148rpx;
  height: 148rpx;
  display: block;
  margin: 0 auto;
  border-radius: 36rpx;
}

.brand {
  margin-top: 28rpx;
  font-size: 52rpx;
  font-weight: 650;
  color: #2f3b35;
  letter-spacing: 4rpx;
}

.tagline {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8fa19a;
  line-height: 1.5;
}

.panel {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 36rpx;
  box-shadow: 0 12rpx 32rpx rgba(80, 110, 96, 0.06);
}

.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0 auto 28rpx;
  display: flex;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar,
.placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.placeholder {
  background: #edf5f0;
  color: #6cbfa6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.nick {
  height: 88rpx;
  background: #f4f9f6;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  font-size: 30rpx;
  color: #2f3b35;
}

.ph {
  color: #b9ccc3;
}

.enter {
  padding: 28rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 650;
  color: #fff;
  background: #6cbfa6;
  box-shadow: 0 12rpx 28rpx rgba(111, 155, 136, 0.28);
}

.enter.disabled {
  opacity: 0.55;
  box-shadow: none;
}
