.login {
  min-height: 100vh;
  padding: 120rpx 32rpx 48rpx;
  background: linear-gradient(180deg, #e8eefc 0%, #f5f7fb 40%, #f5f7fb 100%);
}
.hero { text-align: center; margin-bottom: 48rpx; }
.logo {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 24rpx; border-radius: 32rpx;
  background: #0052d9; color: #fff; font-size: 56rpx; font-weight: 700;
}
.h1 { font-size: 48rpx; font-weight: 700; }
.sub { margin-top: 8rpx; color: #8b8b8b; font-size: 26rpx; }
.avatar-btn {
  background: transparent; padding: 0; margin-bottom: 24rpx;
  display: flex; justify-content: center;
}
.avatar-btn::after { border: none; }
.avatar, .placeholder {
  width: 128rpx; height: 128rpx; border-radius: 50%;
}
.placeholder {
  background: #f2f3ff; color: #618dff;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.nick {
  height: 88rpx; background: #f5f7fb; border-radius: 16rpx;
  padding: 0 24rpx; margin-bottom: 28rpx; font-size: 30rpx;
}
.demo-row { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 8rpx; }
